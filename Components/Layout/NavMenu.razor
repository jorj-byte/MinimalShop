@rendermode InteractiveServer
@inject CartService CartService

<header class="site-header">
    <div class="header-top">
        <a class="logo" href="">مینیمال<span>‌شاپ</span></a>
        <nav class="main-nav">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">خانه</NavLink>
            <NavLink class="nav-link" href="shop">فروشگاه</NavLink>
            <NavLink class="nav-link" href="admin">مدیریت</NavLink>
        </nav>
        <a class="cart-btn" href="cart">
            🛒 سبد خرید
            @if (CartService.ItemCount > 0)
            {
                <span class="cart-badge">@PersianFormat.Number(CartService.ItemCount)</span>
            }
        </a>
    </div>
</header>
