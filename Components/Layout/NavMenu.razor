@inject CartService CartService
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@StoreName</a>
        @if (CartService.ItemCount > 0)
        {
            <span class="badge bg-light text-dark">@CartService.ItemCount</span>
        }
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> خانه
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="shop">
                <span class="bi bi-bag-fill-nav-menu" aria-hidden="true"></span> فروشگاه
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cart">
                <span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> سبد خرید (@CartService.ItemCount)
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> پنل مدیریت
            </NavLink>
        </div>
    </nav>
</div>

@code {
    [Inject] private IOptions<ShopSettings> ShopOptions { get; set; } = default!;

    private string StoreName => ShopOptions.Value.StoreName;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        await CartService.EnsureLoadedAsync();
    }

    public void Dispose() => CartService.OnChange -= StateHasChanged;
}
