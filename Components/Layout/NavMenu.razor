@inject CartService CartService
@inject ShopService ShopService
@inject NavigationManager Navigation
@implements IDisposable

<header class="site-header">
    <div class="header-top">
        <a class="logo" href="">@StoreShopName</a>

        <form class="search-box" @onsubmit="SearchAsync">
            <input type="search" class="search-input" placeholder="جستجو در محصولات..."
                   value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty" />
            <button type="submit" class="search-btn" aria-label="جستجو">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
                </svg>
            </button>
        </form>

        <div class="header-actions">
            <NavLink class="header-action cart-btn" href="cart" aria-label="سبد خرید">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1.5"></circle>
                    <circle cx="19" cy="21" r="1.5"></circle>
                    <path d="M2 3h3l2.6 12.5a2 2 0 0 0 2 1.5h8.7a2 2 0 0 0 2-1.6L22 7H6"></path>
                </svg>
                <span class="cart-badge">@(PersianFormat.Number(CartService.ItemCount))</span>
            </NavLink>
            <NavLink class="header-action admin-link" href="admin">پنل مدیریت</NavLink>
        </div>
    </div>

    <nav class="cat-nav">
        <div class="cat-nav-inner">
            <NavLink class="cat-link" href="" Match="NavLinkMatch.All">خانه</NavLink>
            <NavLink class="cat-link" href="shop">همه محصولات</NavLink>
            @foreach (var category in _categories)
            {
                <NavLink class="cat-link" href="@($"shop?category={category.Id}")">@category.Name</NavLink>
            }
        </div>
    </nav>
</header>

@code {
    [Inject] private IOptions<ShopSettings> ShopOptions { get; set; } = default!;

    private string? _query;
    private List<Category> _categories = [];

    private string StoreShopName => ShopOptions.Value.StoreName;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        await CartService.EnsureLoadedAsync();
        _categories = await ShopService.GetActiveCategoriesAsync();
    }

    private Task SearchAsync()
    {
        var term = _query?.Trim();
        Navigation.NavigateTo(string.IsNullOrWhiteSpace(term) ? "shop" : $"shop?q={Uri.EscapeDataString(term)}");
        _query = string.Empty;
        return Task.CompletedTask;
    }

    public void Dispose() => CartService.OnChange -= StateHasChanged;
}
