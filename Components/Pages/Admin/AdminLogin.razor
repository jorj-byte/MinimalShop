@page "/admin"
@page "/admin/login"
@rendermode InteractiveServer
@inject AdminSession Session
@inject IOptions<AdminSettings> Settings
@inject NavigationManager Navigation

<PageTitle>ورود مدیر</PageTitle>

@if (Session.IsAuthenticated)
{
    Navigation.NavigateTo("/admin/categories");
}
else
{
    <h1 class="page-title">ورود به پنل مدیریت</h1>
    <div class="checkout-box" style="max-width:400px">
        <EditForm Model="model" OnValidSubmit="Login">
            <div class="form-group">
                <label>رمز عبور</label>
                <InputText type="password" @bind-Value="model.Password" class="form-control" />
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <p class="error">@error</p>
            }
            <button class="btn btn-primary" type="submit">ورود</button>
        </EditForm>
    </div>
}

@code {
    private LoginModel model = new();
    private string? error;

    private void Login()
    {
        if (Session.Login(model.Password, Settings.Value.Password))
        {
            Navigation.NavigateTo("/admin/categories");
            return;
        }

        error = "رمز عبور اشتباه است.";
    }

    private sealed class LoginModel
    {
        public string Password { get; set; } = string.Empty;
    }
}
