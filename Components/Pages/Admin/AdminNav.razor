<div class="mb-4">
    <ul class="nav nav-pills gap-2 flex-wrap">
        <li class="nav-item"><a class="nav-link" href="admin/orders">Orders</a></li>
        <li class="nav-item"><a class="nav-link" href="admin/categories">Categories</a></li>
        <li class="nav-item"><a class="nav-link" href="admin/products">Products</a></li>
        <li class="nav-item ms-auto"><a class="nav-link text-danger" href="" @onclick="Logout" @onclick:preventDefault>Logout</a></li>
    </ul>
</div>

@code {
    [Inject] private AdminAuthService Auth { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private void Logout()
    {
        Auth.Logout();
        Navigation.NavigateTo("/admin");
    }
}
