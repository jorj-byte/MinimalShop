@page "/admin/categories"
@rendermode InteractiveServer
@inject AdminAuthService Auth
@inject ShopService Shop
@inject NavigationManager Navigation

<PageTitle>Categories - Admin</PageTitle>

@if (!Auth.IsAuthenticated)
{
    Navigation.NavigateTo("/admin");
}
else
{
    <AdminNav />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Categories</h1>
        <button class="btn btn-primary" @onclick="NewCategory">New category</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info py-2">@_message</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }

    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in _categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.Slug</td>
                        <td>@(category.IsActive ? "Yes" : "No")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => EditCategory(category)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCategoryAsync(category.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing is not null)
    {
        <div class="card">
            <div class="card-body">
                <h2 class="h5">@(_editing.Id == 0 ? "Create" : "Edit") category</h2>
                <EditForm Model="_editing" OnValidSubmit="SaveCategoryAsync">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="_editing.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Slug (optional)</label>
                            <InputText class="form-control" @bind-Value="_editing.Slug" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="_editing.Description" />
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_editing.IsActive" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-success me-2">Save</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _editing = null">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
}

@code {
    private List<Category> _categories = [];
    private Category? _editing;
    private string? _message;
    private string? _error;

    protected override async Task OnInitializedAsync() =>
        _categories = await Shop.GetAllCategoriesAsync();

    private void NewCategory() => _editing = new Category();

    private void EditCategory(Category category) =>
        _editing = new Category
        {
            Id = category.Id,
            Name = category.Name,
            Slug = category.Slug,
            Description = category.Description,
            IsActive = category.IsActive
        };

    private async Task SaveCategoryAsync()
    {
        if (_editing is null) return;

        _error = null;
        await Shop.SaveCategoryAsync(_editing);
        _categories = await Shop.GetAllCategoriesAsync();
        _editing = null;
        _message = "Category saved.";
    }

    private async Task DeleteCategoryAsync(int id)
    {
        _message = null;
        _error = null;

        try
        {
            await Shop.DeleteCategoryAsync(id);
            _categories = await Shop.GetAllCategoriesAsync();
            _message = "Category deleted.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
