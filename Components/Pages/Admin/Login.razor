@page "/admin"
@rendermode InteractiveServer
@inject AdminAuthService Auth
@inject NavigationManager Navigation

<PageTitle>Admin</PageTitle>

@if (Auth.IsAuthenticated)
{
    Navigation.NavigateTo("/admin/orders");
}
else
{
    <div class="row justify-content-center">
        <div class="col-md-5">
            <h1 class="h3 mb-3">Admin login</h1>
            <EditForm Model="_model" OnValidSubmit="LoginAsync">
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="_model.Password" />
                </div>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }
                <button class="btn btn-primary">Sign in</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private readonly LoginModel _model = new();
    private string? _error;

    private Task LoginAsync()
    {
        if (Auth.TryLogin(_model.Password))
            Navigation.NavigateTo("/admin/orders");
        else
            _error = "Invalid password.";

        return Task.CompletedTask;
    }

    private sealed class LoginModel
    {
        public string Password { get; set; } = string.Empty;
    }
}
