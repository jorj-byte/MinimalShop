@page "/admin/orders"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ShopService Shop

<PageTitle>سفارش‌ها - مدیریت</PageTitle>

<AdminNav />

<h1 class="h3 mb-3">سفارش‌ها</h1>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>شماره</th>
                <th>مشتری</th>
                <th>وضعیت</th>
                <th>مبلغ</th>
                <th>تاریخ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in _orders)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>
                        <div>@order.CustomerName</div>
                        <small class="text-muted">@order.CustomerEmail</small>
                    </td>
                    <td><span class="badge text-bg-secondary">@order.Status</span></td>
                    <td>@order.Total.ToString("N0") تومان</td>
                    <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td><a class="btn btn-sm btn-outline-primary" href="@($"admin/orders/{order.Id}")">مشاهده</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<Order> _orders = [];

    protected override async Task OnInitializedAsync() =>
        _orders = await Shop.GetOrdersAsync();
}
