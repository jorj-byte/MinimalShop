@page "/admin/orders"
@rendermode InteractiveServer
@inject AdminAuthService Auth
@inject ShopService Shop
@inject NavigationManager Navigation

<PageTitle>Orders - Admin</PageTitle>

@if (!Auth.IsAuthenticated)
{
    Navigation.NavigateTo("/admin");
}
else
{
    <AdminNav />

    <h1 class="h3 mb-3">Orders</h1>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in _orders)
                {
                    <tr>
                        <td>@order.OrderNumber</td>
                        <td>
                            <div>@order.CustomerName</div>
                            <small class="text-muted">@order.CustomerEmail</small>
                        </td>
                        <td><span class="badge text-bg-secondary">@order.Status</span></td>
                        <td>@order.Total.ToString("C")</td>
                        <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td><a class="btn btn-sm btn-outline-primary" href="@($"admin/orders/{order.Id}")">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Order> _orders = [];

    protected override async Task OnInitializedAsync() =>
        _orders = await Shop.GetOrdersAsync();
}
