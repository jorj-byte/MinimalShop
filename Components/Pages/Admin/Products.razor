@page "/admin/products"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@inject ShopService Shop
@inject IWebHostEnvironment Env

<PageTitle>محصولات - مدیریت</PageTitle>

<AdminNav />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">محصولات</h1>
    <button class="btn btn-primary" @onclick="NewProduct">محصول جدید</button>
</div>

@if (!string.IsNullOrWhiteSpace(_message))
{
    <div class="alert alert-info py-2">@_message</div>
}

<div class="table-responsive mb-4">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>نام</th>
                <th>دسته</th>
                <th>قیمت</th>
                <th>موجودی</th>
                <th>فعال</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in _products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Category.Name</td>
                    <td>@product.Price.ToString("N0") تومان</td>
                    <td>@product.Stock</td>
                    <td>@(product.IsActive ? "بله" : "خیر")</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => EditProduct(product)">ویرایش</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProductAsync(product.Id)">حذف</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_editing is not null)
{
    <div class="card">
        <div class="card-body">
            <h2 class="h5">@(_editing.Id == 0 ? "ایجاد" : "ویرایش") محصول</h2>
            <EditForm Model="_editing" OnValidSubmit="SaveProductAsync">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">نام</label>
                        <InputText class="form-control" @bind-Value="_editing.Name" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">دسته</label>
                        <InputSelect class="form-select" @bind-Value="_editing.CategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">قیمت (تومان)</label>
                        <InputNumber class="form-control" @bind-Value="_editing.Price" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">موجودی</label>
                        <InputNumber class="form-control" @bind-Value="_editing.Stock" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_editing.IsActive" />
                            <label class="form-check-label">فعال</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">توضیحات</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="_editing.Description" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">تصویر محصول</label>
                        @if (!string.IsNullOrEmpty(_editing.ImageUrl))
                        {
                            <div class="d-flex align-items-center gap-3 mb-2">
                                <img src="@_editing.ImageUrl" alt="" style="height:64px; aspect-ratio:4/3; object-fit:cover; border-radius:8px;" />
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveImage">حذف تصویر</button>
                            </div>
                        }
                        <InputFile OnChange="UploadImageAsync" accept="image/jpeg,image/png,image/webp" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">رنگ</label>
                        <InputText class="form-control" @bind-Value="_editing.Color" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">وزن (گرم)</label>
                        <InputNumber class="form-control" @bind-Value="_editing.WeightGrams" />
                    </div>
                    <div class="col-md-4">
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label">طول (cm)</label>
                                <InputNumber class="form-control" @bind-Value="_editing.LengthCm" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">عرض (cm)</label>
                                <InputNumber class="form-control" @bind-Value="_editing.WidthCm" />
                            </div>
                            <div class="col-4">
                                <label class="form-label">ارتفاع (cm)</label>
                                <InputNumber class="form-control" @bind-Value="_editing.HeightCm" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success me-2">ذخیره</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => _editing = null">انصراف</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<Product> _products = [];
    private List<Category> _categories = [];
    private Product? _editing;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _categories = await Shop.GetAllCategoriesAsync();
        _products = await Shop.GetAllProductsAsync();
    }

    private void NewProduct()
    {
        if (_categories.Count == 0) return;
        _editing = new Product { CategoryId = _categories[0].Id, IsActive = true };
    }

    private void EditProduct(Product product) =>
        _editing = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            Stock = product.Stock,
            CategoryId = product.CategoryId,
            IsActive = product.IsActive,
            ImageUrl = product.ImageUrl,
            Color = product.Color,
            WeightGrams = product.WeightGrams,
            LengthCm = product.LengthCm,
            WidthCm = product.WidthCm,
            HeightCm = product.HeightCm
        };

    private async Task SaveProductAsync()
    {
        if (_editing is null) return;

        await Shop.SaveProductAsync(_editing);
        _products = await Shop.GetAllProductsAsync();
        _editing = null;
        _message = "محصول ذخیره شد.";
    }

    private async Task DeleteProductAsync(int id)
    {
        await Shop.DeleteProductAsync(id);
        _products = await Shop.GetAllProductsAsync();
        _message = "محصول حذف شد.";
    }

    private static readonly string[] AllowedExtensions = [".jpg", ".jpeg", ".png", ".webp"];
    private const long MaxImageBytes = 5 * 1024 * 1024;
    private bool _uploading;

    private async Task UploadImageAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (_editing is null || file is null) return;

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!AllowedExtensions.Contains(ext))
        {
            _message = "فرمت تصویر مجاز نیست (فقط jpeg/png/webp).";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            _message = "حجم تصویر بیشتر از ۵ مگابایت است.";
            return;
        }

        _uploading = true;
        try
        {
            var dir = Path.Combine(Env.WebRootPath ?? "wwwroot", "images", "products");
            Directory.CreateDirectory(dir);

            var name = $"upload-{Guid.NewGuid():N}{ext}";
            await using var stream = File.Create(Path.Combine(dir, name));
            await file.OpenReadStream(MaxImageBytes).CopyToAsync(stream);

            _editing.ImageUrl = $"/images/products/{name}";
            _message = "تصویر آپلود شد (برای ثبت، فرم را ذخیره کنید).";
        }
        catch (Exception ex)
        {
            _message = "خطا در آپلود تصویر: " + ex.Message;
        }
        finally
        {
            _uploading = false;
        }
    }

    private void RemoveImage() => _editing.ImageUrl = null;
}
