@page "/admin/products"
@rendermode InteractiveServer
@inject AdminAuthService Auth
@inject ShopService Shop
@inject NavigationManager Navigation

<PageTitle>Products - Admin</PageTitle>

@if (!Auth.IsAuthenticated)
{
    Navigation.NavigateTo("/admin");
}
else
{
    <AdminNav />

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Products</h1>
        <button class="btn btn-primary" @onclick="NewProduct">New product</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert alert-info py-2">@_message</div>
    }

    <div class="table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Active</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in _products)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Category.Name</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.Stock</td>
                        <td>@(product.IsActive ? "Yes" : "No")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => EditProduct(product)">Edit</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProductAsync(product.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_editing is not null)
    {
        <div class="card">
            <div class="card-body">
                <h2 class="h5">@(_editing.Id == 0 ? "Create" : "Edit") product</h2>
                <EditForm Model="_editing" OnValidSubmit="SaveProductAsync">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Name</label>
                            <InputText class="form-control" @bind-Value="_editing.Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category</label>
                            <InputSelect class="form-select" @bind-Value="_editing.CategoryId">
                                @foreach (var category in _categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Price</label>
                            <InputNumber class="form-control" @bind-Value="_editing.Price" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Stock</label>
                            <InputNumber class="form-control" @bind-Value="_editing.Stock" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="_editing.IsActive" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Description</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_editing.Description" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-success me-2">Save</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _editing = null">Cancel</button>
                    </div>
                </EditForm>
            </div>
        </div>
    }
}

@code {
    private List<Product> _products = [];
    private List<Category> _categories = [];
    private Product? _editing;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        _categories = await Shop.GetAllCategoriesAsync();
        _products = await Shop.GetAllProductsAsync();
    }

    private void NewProduct()
    {
        if (_categories.Count == 0) return;
        _editing = new Product { CategoryId = _categories[0].Id, IsActive = true };
    }

    private void EditProduct(Product product) =>
        _editing = new Product
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            Stock = product.Stock,
            CategoryId = product.CategoryId,
            IsActive = product.IsActive
        };

    private async Task SaveProductAsync()
    {
        if (_editing is null) return;

        await Shop.SaveProductAsync(_editing);
        _products = await Shop.GetAllProductsAsync();
        _editing = null;
        _message = "Product saved.";
    }

    private async Task DeleteProductAsync(int id)
    {
        await Shop.DeleteProductAsync(id);
        _products = await Shop.GetAllProductsAsync();
        _message = "Product deleted.";
    }
}
