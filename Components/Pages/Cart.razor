@page "/cart"
@rendermode InteractiveServer
@inject CartService CartService
@implements IDisposable

<PageTitle>Cart</PageTitle>

<h1 class="mb-3">Your cart</h1>

@if (CartService.Lines.Count == 0)
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" href="shop">Continue shopping</a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th style="width: 120px;">Qty</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in CartService.Lines)
                {
                    <tr>
                        <td>@line.Name</td>
                        <td>@line.Price.ToString("C")</td>
                        <td>
                            <input type="number" min="1" class="form-control"
                                   value="@line.Quantity"
                                   @onchange="e => UpdateQty(line.ProductId, e)" />
                        </td>
                        <td>@line.LineTotal.ToString("C")</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CartService.Remove(line.ProductId)">Remove</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <strong>Subtotal: @CartService.Subtotal.ToString("C")</strong>
        <a class="btn btn-success" href="checkout">Checkout</a>
    </div>
}

@code {
    protected override void OnInitialized() => CartService.OnChange += StateHasChanged;

    private void UpdateQty(int productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
            CartService.UpdateQuantity(productId, qty);
    }

    public void Dispose() => CartService.OnChange -= StateHasChanged;
}
