@page "/cart"
@rendermode InteractiveServer
@inject CartService CartService
@inject NavigationManager Navigation

<PageTitle>سبد خرید</PageTitle>

<h1 class="page-title">سبد خرید</h1>

@if (CartService.Items.Count == 0)
{
    <div class="empty-state">
        <p>سبد خرید شما خالی است.</p>
        <a href="shop">بازگشت به فروشگاه</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table">
            <thead>
                <tr>
                    <th>محصول</th>
                    <th>قیمت واحد</th>
                    <th>تعداد</th>
                    <th>جمع</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in CartService.Items)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@PersianFormat.Price(item.Price)</td>
                        <td>
                            <input type="number" min="1" value="@item.Quantity" class="form-control" style="width:80px"
                                   @onchange="e => UpdateQty(item.ProductId, e)" />
                        </td>
                        <td>@PersianFormat.Price(item.LineTotal)</td>
                        <td>
                            <button class="btn btn-link" @onclick="() => CartService.Remove(item.ProductId)">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="cart-total">جمع کل: <strong>@PersianFormat.Price(CartService.Total)</strong></p>
    <button class="btn btn-primary" @onclick="GoCheckout">ادامه و ثبت سفارش</button>
}

@code {
    private void UpdateQty(int productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
        {
            CartService.UpdateQuantity(productId, qty);
        }
    }

    private void GoCheckout() => Navigation.NavigateTo("/checkout");
}
