@page "/cart"
@rendermode InteractiveServer
@inject CartService CartService
@implements IDisposable

<PageTitle>سبد خرید — مینیمال‌شاپ</PageTitle>

<h1 class="mb-3">سبد خرید</h1>

@if (CartService.Lines.Count == 0)
{
    <p>سبد خرید شما خالی است.</p>
    <a class="btn btn-primary" href="shop">ادامه خرید</a>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>محصول</th>
                    <th>قیمت</th>
                    <th style="width: 120px;">تعداد</th>
                    <th>جمع</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in CartService.Lines)
                {
                    <tr>
                        <td>@line.Name</td>
                        <td>@PersianFormat.Price(line.Price)</td>
                        <td>
                            <input type="number" min="1" class="form-control"
                                   value="@line.Quantity"
                                   @onchange="e => UpdateQty(line.ProductId, e)" />
                        </td>
                        <td>@PersianFormat.Price(line.LineTotal)</td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => CartService.Remove(line.ProductId)">حذف</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-3">
        <strong>جمع کل: @PersianFormat.Price(CartService.Subtotal)</strong>
        <a class="btn btn-success" href="checkout">تکمیل سفارش</a>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        await CartService.EnsureLoadedAsync();
    }

    private void UpdateQty(int productId, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var qty))
            CartService.UpdateQuantity(productId, qty);
    }

    public void Dispose() => CartService.OnChange -= StateHasChanged;
}
