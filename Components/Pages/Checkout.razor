@page "/checkout"
@rendermode InteractiveServer
@inject CartService CartService
@inject ShopService ShopService
@inject NavigationManager Navigation

<PageTitle>Checkout</PageTitle>

<h1 class="mb-3">Checkout</h1>

@if (CartService.Lines.Count == 0 && !_orderPlaced)
{
    <p>Your cart is empty.</p>
    <a class="btn btn-primary" href="shop">Go to shop</a>
}
else if (_orderPlaced && _order is not null)
{
    <div class="alert alert-success">
        <h2 class="h5">Order placed!</h2>
        <p>Order <strong>@_order.OrderNumber</strong> for @_order.Total.ToString("C") was received.</p>
        <a class="btn btn-primary" href="shop">Continue shopping</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <EditForm Model="_model" OnValidSubmit="PlaceOrderAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">Full name</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerEmail" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone (optional)</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerPhone" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Shipping address</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_model.ShippingAddress" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <button class="btn btn-success" disabled="@_submitting">
                    @(_submitting ? "Placing order..." : $"Place order ({CartService.Subtotal:C})")
                </button>
            </EditForm>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6">Order summary</h2>
                    <ul class="list-unstyled mb-0">
                        @foreach (var line in CartService.Lines)
                        {
                            <li class="d-flex justify-content-between small py-1 border-bottom">
                                <span>@line.Name x @line.Quantity</span>
                                <span>@line.LineTotal.ToString("C")</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-bold mt-3">
                        <span>Total</span>
                        <span>@CartService.Subtotal.ToString("C")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CheckoutModel _model = new();
    private bool _submitting;
    private bool _orderPlaced;
    private string? _error;
    private Order? _order;

    private async Task PlaceOrderAsync()
    {
        _submitting = true;
        _error = null;

        try
        {
            _order = await ShopService.PlaceOrderAsync(
                _model.CustomerName,
                _model.CustomerEmail,
                _model.CustomerPhone,
                _model.ShippingAddress,
                CartService.Lines);

            CartService.Clear();
            _orderPlaced = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class CheckoutModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(120)]
        public string CustomerName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string CustomerEmail { get; set; } = string.Empty;

        public string? CustomerPhone { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.StringLength(500)]
        public string ShippingAddress { get; set; } = string.Empty;
    }
}
