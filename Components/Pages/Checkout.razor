@page "/checkout"
@rendermode InteractiveServer
@inject CartService Cart
@inject OrderService Orders
@inject NavigationManager Navigation

<PageTitle>Checkout</PageTitle>

<h1>Checkout</h1>

@if (Cart.Items.Count == 0)
{
    <p>Your cart is empty. <a href="shop">Go to shop</a></p>
}
else
{
    <EditForm Model="model" OnValidSubmit="PlaceOrder">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Name</label>
            <InputText @bind-Value="model.Name" class="form-control" />
        </div>
        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="model.Email" class="form-control" />
        </div>
        <div class="form-group">
            <label>Phone</label>
            <InputText @bind-Value="model.Phone" class="form-control" />
        </div>
        <div class="form-group">
            <label>Shipping address</label>
            <InputTextArea @bind-Value="model.Address" class="form-control" rows="3" />
        </div>

        <p class="cart-total">Order total: <strong>@Cart.Total.ToString("C")</strong></p>

        @if (!string.IsNullOrEmpty(error))
        {
            <p class="error">@error</p>
        }

        <button class="btn btn-primary" type="submit" disabled="@submitting">Place order</button>
    </EditForm>
}

@code {
    private CheckoutModel model = new();
    private string? error;
    private bool submitting;

    private async Task PlaceOrder()
    {
        submitting = true;
        error = null;

        var order = await Orders.PlaceOrderAsync(model.Name, model.Email, model.Phone, model.Address);
        if (order is null)
        {
            error = "Could not place order. Check stock and try again.";
            submitting = false;
            return;
        }

        Navigation.NavigateTo($"/order/{order.Id}");
    }

    private sealed class CheckoutModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        public string? Phone { get; set; }
        public string? Address { get; set; }
    }
}
