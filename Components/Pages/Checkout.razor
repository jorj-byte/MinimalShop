@page "/checkout"
@rendermode InteractiveServer
@inject CartService CartService
@inject ShopService ShopService
@inject NavigationManager Navigation

<PageTitle>تکمیل سفارش — مینیمال‌شاپ</PageTitle>

<h1 class="mb-3">تکمیل سفارش</h1>

@if (CartService.Lines.Count == 0 && !_orderPlaced)
{
    <p>سبد خرید شما خالی است.</p>
    <a class="btn btn-primary" href="shop">مشاهده محصولات</a>
}
else if (_orderPlaced && _order is not null)
{
    <div class="alert alert-success">
        <h2 class="h5">سفارش با موفقیت ثبت شد!</h2>
        <p>شماره سفارش <strong>@_order.OrderNumber</strong> به مبلغ @PersianFormat.Price(_order.Total) ثبت شد.</p>
        <a class="btn btn-primary" href="shop">ادامه خرید</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <EditForm Model="_model" OnValidSubmit="PlaceOrderAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">نام و نام خانوادگی</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerName" />
                </div>
                <div class="mb-3">
                    <label class="form-label">ایمیل</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerEmail" />
                </div>
                <div class="mb-3">
                    <label class="form-label">شماره تماس (اختیاری)</label>
                    <InputText class="form-control" @bind-Value="_model.CustomerPhone" />
                </div>
                <div class="mb-3">
                    <label class="form-label">نشانی تحویل سفارش</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_model.ShippingAddress" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                <button class="btn btn-success" disabled="@_submitting">
                    @(_submitting ? "در حال ثبت سفارش..." : $"ثبت سفارش ({PersianFormat.Price(CartService.Subtotal)})")
                </button>
            </EditForm>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6">خلاصه سفارش</h2>
                    <ul class="list-unstyled mb-0">
                        @foreach (var line in CartService.Lines)
                        {
                            <li class="d-flex justify-content-between small py-1 border-bottom">
                                <span>@line.Name × @PersianFormat.Number(line.Quantity)</span>
                                <span>@PersianFormat.Price(line.LineTotal)</span>
                            </li>
                        }
                    </ul>
                    <div class="d-flex justify-content-between fw-bold mt-3">
                        <span>جمع کل</span>
                        <span>@PersianFormat.Price(CartService.Subtotal)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private readonly CheckoutModel _model = new();
    private bool _submitting;
    private bool _orderPlaced;
    private string? _error;
    private Order? _order;

    private async Task PlaceOrderAsync()
    {
        _submitting = true;
        _error = null;

        try
        {
            _order = await ShopService.PlaceOrderAsync(
                _model.CustomerName,
                _model.CustomerEmail,
                _model.CustomerPhone,
                _model.ShippingAddress,
                CartService.Lines);

            CartService.Clear();
            _orderPlaced = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed class CheckoutModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "وارد کردن نام الزامی است.")]
        [System.ComponentModel.DataAnnotations.StringLength(120)]
        public string CustomerName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "وارد کردن ایمیل الزامی است.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "ایمیل واردشده معتبر نیست.")]
        public string CustomerEmail { get; set; } = string.Empty;

        public string? CustomerPhone { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "وارد کردن نشانی الزامی است.")]
        [System.ComponentModel.DataAnnotations.StringLength(500)]
        public string ShippingAddress { get; set; } = string.Empty;
    }
}
