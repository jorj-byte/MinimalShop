@page "/checkout"
@rendermode InteractiveServer
@inject CartService CartService
@inject OrderService OrderService
@inject NavigationManager Navigation

<PageTitle>ثبت سفارش</PageTitle>

<h1 class="page-title">ثبت سفارش</h1>

@if (CartService.Items.Count == 0)
{
    <div class="empty-state">
        <p>سبد خرید شما خالی است.</p>
        <a href="shop">رفتن به فروشگاه</a>
    </div>
}
else
{
    <div class="checkout-box">
        <EditForm Model="model" OnValidSubmit="PlaceOrder">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>نام و نام خانوادگی</label>
                <InputText @bind-Value="model.Name" class="form-control" />
            </div>
            <div class="form-group">
                <label>ایمیل</label>
                <InputText @bind-Value="model.Email" class="form-control" />
            </div>
            <div class="form-group">
                <label>شماره موبایل</label>
                <InputText @bind-Value="model.Phone" class="form-control" placeholder="۰۹۱۲..." />
            </div>
            <div class="form-group">
                <label>آدرس تحویل</label>
                <InputTextArea @bind-Value="model.Address" class="form-control" rows="3" />
            </div>

            <p class="cart-total">مبلغ قابل پرداخت: <strong>@PersianFormat.Price(CartService.Total)</strong></p>

            @if (!string.IsNullOrEmpty(error))
            {
                <p class="error">@error</p>
            }

            <button class="btn btn-primary" type="submit" disabled="@submitting">ثبت سفارش</button>
        </EditForm>
    </div>
}

@code {
    private CheckoutModel model = new();
    private string? error;
    private bool submitting;

    private async Task PlaceOrder()
    {
        submitting = true;
        error = null;

        var order = await OrderService.PlaceOrderAsync(model.Name, model.Email, model.Phone, model.Address);
        if (order is null)
        {
            error = "ثبت سفارش ممکن نشد. موجودی کالا را بررسی کنید.";
            submitting = false;
            return;
        }

        Navigation.NavigateTo($"/order/{order.Id}");
    }

    private sealed class CheckoutModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "نام الزامی است")]
        public string Name { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "ایمیل الزامی است")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "ایمیل معتبر نیست")]
        public string Email { get; set; } = string.Empty;

        public string? Phone { get; set; }
        public string? Address { get; set; }
    }
}
