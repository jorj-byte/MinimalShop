@page "/"
@rendermode InteractiveServer

<PageTitle>MinimalShop</PageTitle>

<div class="hero">
    <h1>Welcome to MinimalShop</h1>
    <p class="lead">A lightweight .NET 10 shop with category and order management.</p>
    <a class="btn btn-primary" href="shop">Browse products</a>
</div>

<section class="features">
    <div class="feature-card">
        <h3>Categories</h3>
        <p>Organize products into clear categories for easy browsing.</p>
    </div>
    <div class="feature-card">
        <h3>Orders</h3>
        <p>Track customer orders from pending to delivered.</p>
    </div>
    <div class="feature-card">
        <h3>Deploy anywhere</h3>
        <p>Runs on a minimal Hetzner VPS with Docker and PostgreSQL.</p>
    </div>
</section>
