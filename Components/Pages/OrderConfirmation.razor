@page "/order/{OrderId:int}"
@rendermode InteractiveServer
@inject OrderService OrderService

<PageTitle>تأیید سفارش</PageTitle>

<h1 class="page-title">سفارش ثبت شد ✓</h1>

@if (order is null)
{
    <div class="empty-state">
        <p>سفارش یافت نشد.</p>
    </div>
}
else
{
    <div class="checkout-box">
        <p>@order.CustomerName عزیز، سفارش شما با شماره <strong>@PersianFormat.Number(order.Id)</strong> ثبت شد.</p>
        <p>وضعیت: <span class="badge">@PersianFormat.StatusLabel(order.Status)</span></p>
        <p>مبلغ کل: <strong>@PersianFormat.Price(order.TotalAmount)</strong></p>

        <div class="table-wrap" style="margin-top:1rem">
            <table class="table">
                <thead>
                    <tr>
                        <th>محصول</th>
                        <th>تعداد</th>
                        <th>قیمت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in order.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@PersianFormat.Number(item.Quantity)</td>
                            <td>@PersianFormat.Price(item.LineTotal)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a href="shop" class="btn btn-primary" style="margin-top:1rem">ادامه خرید</a>
    </div>
}

@code {
    [Parameter] public int OrderId { get; set; }
    private Order? order;

    protected override async Task OnInitializedAsync() =>
        order = await OrderService.GetOrderAsync(OrderId);
}
