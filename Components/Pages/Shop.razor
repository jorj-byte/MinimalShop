@page "/shop"
@rendermode InteractiveServer
@inject ShopService ShopService
@inject CartService CartService

<PageTitle>محصولات — مینیمال‌شاپ</PageTitle>

<h1 class="mb-3">محصولات</h1>

@if (!string.IsNullOrWhiteSpace(_searchTerm))
{
    <div class="filter-bar">
        <span>نتایج جستجو برای «@_searchTerm»</span>
        <a class="btn-link" href="shop">حذف جستجو</a>
    </div>
}

<div class="row mb-4">
    <div class="col-md-4">
        <label class="form-label">دسته‌بندی</label>
        <select class="form-select" @bind="_selectedCategoryId">
            <option value="">همه دسته‌ها</option>
            @foreach (var category in _categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-outline-primary" @onclick="LoadProductsAsync">اعمال فیلتر</button>
    </div>
</div>

@if (_loading)
{
    <p>در حال بارگذاری...</p>
}
else if (_products.Count == 0)
{
    <div class="empty-state">
        <p>محصولی یافت نشد.</p>
        <a class="btn-link" href="shop">مشاهده همه محصولات</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var product in _products)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <div class="card-media">
                            <img src="@product.ImageUrl" alt="@product.Name" loading="lazy" />
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <span class="badge text-bg-light border align-self-start mb-2">@product.Category.Name</span>
                        <h2 class="h5">
                            <NavLink class="product-link" href="@($"product/{product.Id}")">@product.Name</NavLink>
                        </h2>
                        <p class="text-muted small flex-grow-1">@product.Description</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">@PersianFormat.Price(product.Price)</div>
                                <small class="text-muted">@PersianFormat.Number(product.Stock) عدد موجود</small>
                            </div>
                            <button class="btn btn-primary"
                                    disabled="@(product.Stock <= 0)"
                                    @onclick="() => CartService.Add(product.Id, product.Name, product.Price)">
                                افزودن به سبد
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? SearchQuery { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? CategoryParam { get; set; }

    private bool _loading = true;
    private string _selectedCategoryId = "";
    private string _searchTerm = "";
    private string _lastQ = "\0";
    private string _lastCategory = "\0";
    private List<Category> _categories = [];
    private List<Product> _products = [];

    protected override void OnInitialized() { /* data loading happens in OnParametersSetAsync */ }

    protected override async Task OnParametersSetAsync()
    {
        var q = SearchQuery?.Trim() ?? "";
        var category = CategoryParam ?? "";

        if (q == _lastQ && category == _lastCategory)
            return;

        _lastQ = q;
        _lastCategory = category;
        _selectedCategoryId = category;
        _searchTerm = q;

        _loading = true;
        try
        {
            if (_categories.Count == 0)
                _categories = await ShopService.GetActiveCategoriesAsync();

            int? categoryId = int.TryParse(_selectedCategoryId, out var id) ? id : null;
            _products = await ShopService.GetActiveProductsAsync(categoryId, _searchTerm);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadProductsAsync()
    {
        int? categoryId = int.TryParse(_selectedCategoryId, out var id) ? id : null;
        _products = await ShopService.GetActiveProductsAsync(categoryId, _searchTerm);
        StateHasChanged();
    }
}
