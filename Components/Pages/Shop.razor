@page "/shop"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject CartService CartService

<PageTitle>فروشگاه</PageTitle>

<h1 class="page-title">فروشگاه</h1>

<div class="filter-bar">
    <label>دسته‌بندی:</label>
    <select @bind="SelectedCategoryId" @bind:after="LoadProducts">
        <option value="0">همه دسته‌ها</option>
        @foreach (var category in categories)
        {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
</div>

@if (products.Count == 0)
{
    <div class="empty-state">
        <p>محصولی یافت نشد.</p>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var product in products)
        {
            <article class="product-card">
                <span class="category-tag">@product.Category.Name</span>
                <h3>@product.Name</h3>
                <p class="desc">@product.Description</p>
                <p class="price">@PersianFormat.Price(product.Price)</p>
                <p class="stock @(product.Stock <= 0 ? "out" : "")">
                    @(product.Stock > 0 ? $"موجود در انبار ({PersianFormat.Number(product.Stock)} عدد)" : "ناموجود")
                </p>
                <button class="btn btn-primary"
                        disabled="@(product.Stock <= 0)"
                        @onclick="() => AddToCart(product)">
                    افزودن به سبد
                </button>
            </article>
        }
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <p class="success">@message</p>
}

@code {
    private List<Category> categories = [];
    private List<Product> products = [];
    private int SelectedCategoryId;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        categories = await Db.Categories
            .Where(c => c.IsActive)
            .OrderBy(c => c.Name)
            .ToListAsync();
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        var query = Db.Products
            .Include(p => p.Category)
            .Where(p => p.IsActive && p.Stock > 0);

        if (SelectedCategoryId > 0)
        {
            query = query.Where(p => p.CategoryId == SelectedCategoryId);
        }

        products = await query.OrderBy(p => p.Name).ToListAsync();
    }

    private void AddToCart(Product product)
    {
        CartService.Add(product.Id, product.Name, product.Price);
        message = $"«{product.Name}» به سبد خرید اضافه شد.";
    }
}
